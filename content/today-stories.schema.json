{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knewzly:content/today-stories.schema.json",
  "title": "Knewzly Today panel feed",
  "description": "Documented contract for content/today-stories.json. Written only by the scheduled CI news-refresh job (T10) — never by the frontend at runtime (design.md §6).",
  "type": "object",
  "required": ["lastUpdated", "freshnessState", "stories"],
  "additionalProperties": false,
  "properties": {
    "lastUpdated": { "type": "string", "format": "date-time" },
    "freshnessState": {
      "type": "string",
      "enum": ["fresh", "stale", "very_stale", "no_data", "error"],
      "description": "Computed by the CI job as min() across all included sources' individual freshness — never inferred by the frontend beyond an aging floor (design.md §14 risk mitigation)."
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "story": {
      "type": "object",
      "required": ["id", "category", "headline", "source", "traceToAnchors"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "anyOf": [{ "pattern": "^[a-z0-9_-]+$" }, { "format": "https-url" }] },
        "category": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "dek": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["name", "url", "publishedDate"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "https-url" },
            "publishedDate": { "type": "string", "format": "date" }
          }
        },
        "traceToAnchors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Each entry must resolve to a real anchors.json id — checked by the validator."
        },
        "traceLabel": { "type": "string", "minLength": 1 }
      }
    }
  }
}
